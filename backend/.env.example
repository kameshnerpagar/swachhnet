# =================================================================
# SwachhNet AWS Cloud Architecture — Environment Configuration
# NOTE: Placeholders only. Never commit real secrets to Git.
# =================================================================

# Server Port
PORT=5000
NODE_ENV=development

# Database Configuration (Amazon RDS for PostgreSQL or Local Postgres)
DATABASE_URL=postgresql://swachhnet_user:YourSecurePassword@swachhnet-rds-db.cxxxxxx.ap-south-1.rds.amazonaws.com:5432/swachhnet
PGHOST=localhost
PGPORT=5432
PGDATABASE=swachhnet
PGUSER=postgres-
PGPASSWORD=YourLocalPassword
PGSSL=false

# Authentication
JWT_SECRET=replace_with_a_secure_random_64_char_string

# Amazon Web Services (AWS) Configuration
AWS_REGION=ap-south-1
S3_BUCKET_NAME=swachhnet-evidence-storage-bucket
SQS_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/123456789012/swachhnet-jobs-queue

# AWS Monitoring & Systems Manager
USE_SSM=false
ENABLE_CLOUDWATCH_LOGS=false
CLOUDWATCH_LOG_GROUP=/swachhnet/backend

# AI Image Verification (Google Gemini Flash)
G_API=your_google_gemini_api_key_here
SKIP_AI_VALIDATION=false
STRICT_AI_VALIDATION=false
